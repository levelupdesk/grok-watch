name: gateway-ci
on:
  push:
    branches: [main]
    paths: ["gateway/**", ".github/workflows/gateway-ci.yml"]
  pull_request:
    paths: ["gateway/**", ".github/workflows/gateway-ci.yml"]
jobs:
  test:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: gateway
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Install
        run: pip install -e ".[dev]"
      - name: Test
        run: pytest -q
